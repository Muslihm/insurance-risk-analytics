"# Task 1: Exploratory Data Analysis - Insurance Claims Data\n",
"\n",
"## Business Context\n",
"Analysis of AlphaCare Insurance Solutions historical claims data (Feb 2014 - Aug 2015) to optimize marketing strategy and identify low-risk segments.\n",
"\n",
"## Key Questions\n",
"1. What is the overall Loss Ratio? How does it vary by Province, VehicleType, and Gender?\n",
"2. What are the distributions of key financial variables? Are there outliers?\n",
"3. Are there temporal trends in claim frequency or severity?\n",
"4. Which vehicle makes/models are associated with highest/lowest claim amounts?"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"source": [
"import sys\n",
"sys.path.append('..')\n",
"import pandas as pd\n",
"import numpy as np\n",
"import matplotlib.pyplot as plt\n",
"import seaborn as sns\n",
"from src.data_loader import InsuranceDataLoader\n",
"from src.eda_utils import EDAAnalyzer, create_insight_visualizations\n",
"\n",
"plt.style.use('seaborn-v0_8-darkgrid')\n",
"sns.set_palette("husl")\n",
"%matplotlib inline"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"source": [
"# Load data\n",
"loader = InsuranceDataLoader()\n",
"try:\n",
" df = loader.load_data()\n",
" print(f"Data loaded successfully. Shape: {df.shape}")\n",
"except FileNotFoundError:\n",
" print("Real data not found. Using sample data for demonstration.")\n",
" from src.data_loader import create_sample_data\n",
" df = create_sample_data()\n",
" print(f"Sample data created. Shape: {df.shape}")\n",
"\n",
"# Validate data\n",
"is_valid, report = loader.validate_data() if 'loader' in dir() else (True, {})\n",
"print("\nData Quality Report:")\n",
"for key, value in report.items():\n",
" print(f" {key}: {value}")"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"source": [
"# Initialize analyzer\n",
"analyzer = EDAAnalyzer(df)\n",
"\n",
"# Calculate loss ratio\n",
"overall_loss_ratio = analyzer.calculate_loss_ratio()\n",
"print(f"Overall Portfolio Loss Ratio: {overall_loss_ratio:.2%}")\n",
"\n",
"# Loss ratio by province\n",
"loss_by_province = analyzer.loss_ratio_by_group('Province')\n",
"print("\nLoss Ratio by Province:")\n",
"print(loss_by_province.sort_values('LossRatio', ascending=False))"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"source": [
"# Outlier detection\n",
"for col in ['TotalPremium', 'TotalClaims', 'CustomValueEstimate']:\n",
" if col in df.columns:\n",
" outliers, count = analyzer.detect_outliers(col)\n",
" print(f"{col}: {count} outliers detected ({count/len(df)*100:.1f}%)")"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"source": [
"# Create insight visualizations\n",
"visualizations = create_insight_visualizations(df)\n",
"\n",
"# Display each visualization\n",
"for name, fig in visualizations.items():\n",
" if fig:\n",
" plt.figure(fig)\n",
" plt.show()"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"source": [
"# Geographic trends\n",
"analyzer.plot_geographic_trends(['TotalPremium', 'TotalClaims'])\n",
"plt.show()"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"source": [
"# Temporal trends\n",
"analyzer.plot_temporal_trends()\n",
"plt.show()"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"source": [
"# Vehicle analysis\n",
"analyzer.plot_vehicle_analysis(top_n=10)\n",
"plt.show()"
]
}
